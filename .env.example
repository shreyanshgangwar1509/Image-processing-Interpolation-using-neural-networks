# Kaggle API Credentials
# Obtain your key from Kaggle -> Settings -> API -> "Create New Token" (downloads kaggle.json)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Git repository settings used by the remote Kaggle kernel
KAGGLE_REPO_URL=https://github.com/sureshkumarhere/Image-processing-Interpolation-using-neural-networks.git
KAGGLE_BRANCH=exp-v6

# Experiment configs to train (comma-separated paths relative to repo root)
KAGGLE_CONFIGS=configs/our_nn_x4_noise15_a1_skip.yaml
